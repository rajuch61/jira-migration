{
  "prod": {
    "source": {
      "type": "jira",
      "server": "${JIRA_SERVER}",
      "project": "${JIRA_PROJECT}",
      "auth_type": "${JIRA_AUTH_TYPE}",
      "bearer_token": "${JIRA_BEARER_TOKEN}",
      "verify_ssl": false,
      "api_path": "${JIRA_API_PATH}",
      "timeout": 60,
      "module": "connectors.jira_connector",
      "class": "JiraConnector"
    },
    "target": {
      "type": "jira",
      "server": "${JIRA_SERVER}",
      "project": "${JIRA_PROJECT}",
      "auth_type": "${JIRA_AUTH_TYPE}",
      "bearer_token": "${JIRA_BEARER_TOKEN}",
      "verify_ssl": false,
      "api_path": "${JIRA_API_PATH}",
      "timeout": 60,
      "module": "connectors.jira_connector",
      "class": "JiraConnector"
    }
  },
  "local": {
    "source": {
      "type": "json",
      "location": "./source",
      "module": "connectors.json_connector",
      "class": "JsonConnector"
    },
    "target": {
      "type": "json",
      "location": "./target",
      "module": "connectors.json_connector",
      "class": "JsonConnector"
    }
  }
}
